# HEADER_BEGIN

# Import module
import threading

# Constants
TRAJECTORY_RESULT_SUCCESS = 0
TRAJECTORY_RESULT_CANCELED = 1
TRAJECTORY_RESULT_FAILURE = 2

TRAJECTORY_ACTION_CANCEL = -1
TRAJECTORY_ACTION_NOOP = 0
TRAJECTORY_ACTION_START = 1

TRAJECTORY_MOTION_JOINT = 0
TRAJECTORY_MOTION_CARTESIAN = 1

POS_ZOOM_RATIO = {{POS_ZOOM_RATIO_REPLACE}}
TIME_ZOOM_RATIO = {{TIME_ZOOM_RATIO_REPLACE}}
COMMON_ZOOM_RATIO = {{COMMON_ZOOM_RATIO_REPLACE}}

MODE_STOPPED = -2
MODE_UNINITIALIZED = -1
MODE_IDLE = 0
MODE_SERVOJ = 1
MODE_SPEEDJ = 2
MODE_TRAJECTORY = 3
MODE_SPEEDL = 4
MODE_POSE = 5
MODE_FREEDRIVE = 6
MODE_TOOL_IN_CONTACT = 7

STOPJ_ACCELERATION = {{STOP_J_REPLACE}}

# Radians. The first servoj target of a servo session is refused if any joint
# lies farther than this from the arm's actual position. The host starts each
# servo session from the arm's measured state. A large gap therefore means a
# stale or corrupt command. The driver supplies this value.
SERVOJ_START_DELTA_LIMIT = {{SERVOJ_START_DELTA_LIMIT_REPLACE}}

# Kilograms. A payload mass above this value is refused. The driver supplies this value.
PAYLOAD_MASS_MAX = {{PAYLOAD_MASS_MAX_REPLACE}}

SCRIPT_CMD_ZERO_FTSENSOR = 0
SCRIPT_CMD_SET_PAYLOAD = 1
SCRIPT_CMD_SET_TOOL_VOLTAGE = 2
SCRIPT_CMD_START_FORCE_MODE = 3
SCRIPT_CMD_END_FORCE_MODE = 4

TOOL_VOLTAGE_OFF = 0
TOOL_VOLTAGE_12V = 12
TOOL_VOLTAGE_24V = 24

# Seconds. A trajectory waits this long in total for its next point. Longer
# silence fails the trajectory and reports TRAJECTORY_RESULT_FAILURE.
TRAJECTORY_POINT_TIMEOUT = 1.0

FREEDRIVE_START = 1
FREEDRIVE_NOOP = 0
FREEDRIVE_END = -1

# Data size of the message received on the reverse interface
REVERSE_DATA_SIZE = {{REVERSE_DATA_SIZE_REPLACE}}
TRAJECTORY_DATA_SIZE = {{TRAJECTORY_DATA_SIZE_REPLACE}}
SCRIPT_COMMAND_DATA_SIZE = {{SCRIPT_COMMAND_DATA_SIZE_REPLACE}}

# Ensure that the cmd_servo_joints variable is synchronized under multi-threaded conditions
SERVOJ_DATA_MUTEX = threading.Lock()
# Same for cmd_speedl_tool_speed and cmd_speed_joint
SPEED_DATA_MUTEX = threading.Lock()

# Global variables are also showed in the Teach pendants variable list
global control_mode
global cmd_speedl_tool_speed
global cmd_speed_joint
global steptime
global trajectory_point_num
global cmd_servo_joints
global servo_start_check_pending
global trajectory_result
global trajectory_point_wait
global freedrive_active

textmsg("ExternalControl: Script started")

# A failed read consumes no point. The point may simply not have arrived yet.
# Silence beyond TRAJECTORY_POINT_TIMEOUT fails the trajectory. The remaining
# count stays intact, so trajectoryClearPoints() can drain any late arrivals.
def runTrajectoryIteration():
    global trajectory_point_num
    global trajectory_result
    global trajectory_point_wait
    raw_point = socket_read_binary_integer(TRAJECTORY_DATA_SIZE, "trajectory_socket", get_steptime())
    if raw_point[0] > 0:
        trajectory_point_wait = 0.0
        trajectory_point_num -= 1

        if trajectory_point_num <= 0:
            blend_radius = 0
        else:
            blend_radius = raw_point[20] / POS_ZOOM_RATIO

        point = [raw_point[1] / POS_ZOOM_RATIO, raw_point[2] / POS_ZOOM_RATIO, raw_point[3] / POS_ZOOM_RATIO, raw_point[4] / POS_ZOOM_RATIO, raw_point[5] / POS_ZOOM_RATIO, raw_point[6] / POS_ZOOM_RATIO]
        time = raw_point[19] / TIME_ZOOM_RATIO

        motion_type = raw_point[21]

        if motion_type == TRAJECTORY_MOTION_JOINT:
            movej(point, t = time, r = blend_radius)
        elif motion_type == TRAJECTORY_MOTION_CARTESIAN:
            movel(point, t = time, r = blend_radius)
        else:
            textmsg("ExternalControl: trajectory point skipped | unsupported motion type " + str(motion_type))
    else:
        trajectory_point_wait = trajectory_point_wait + get_steptime()
        if trajectory_point_wait > TRAJECTORY_POINT_TIMEOUT:
            textmsg("ExternalControl: trajectory failed | timed out waiting for a point | " + str(trajectory_point_num) + " points left")
            trajectory_result = TRAJECTORY_RESULT_FAILURE

def trajectoryThread():
    global trajectory_result
    global trajectory_point_wait
    trajectory_result = TRAJECTORY_RESULT_SUCCESS
    trajectory_point_wait = 0.0
    while trajectory_point_num > 0 and trajectory_result == TRAJECTORY_RESULT_SUCCESS:
        runTrajectoryIteration()

    socket_send_int(trajectory_result, "trajectory_socket")

def setServoSetpoint(joints):
    global cmd_servo_joints
    with SERVOJ_DATA_MUTEX:
        cmd_servo_joints = joints

# Vets the first servoj target of a servo session against the arm's actual
# position. A target within SERVOJ_START_DELTA_LIMIT on every joint clears
# servo_start_check_pending. A farther target logs, raises a popup, and halts
# the script. The check is independent of anything on the host side. Later
# targets in the session follow the host's own smooth trajectory and skip it.
# abs() is unconfirmed on the robot interpreter, so a manual sign flip stands in.
def verifyServoStartSetpoint(target_joints):
    global servo_start_check_pending
    actual_joints = get_actual_joint_positions()
    fault_msg = ""
    i = 0
    while i < 6:
        delta = target_joints[i] - actual_joints[i]
        if delta < 0:
            delta = 0 - delta
        if delta > SERVOJ_START_DELTA_LIMIT and fault_msg == "":
            fault_msg = "ExternalControl: servoj start target refused on joint " + str(i) + " | delta=" + str(delta) + " | limit=" + str(SERVOJ_START_DELTA_LIMIT) + " | target=" + str(target_joints[i]) + " | actual=" + str(actual_joints[i])
        i += 1
    if fault_msg == "":
        servo_start_check_pending = False
    else:
        textmsg(fault_msg)
        popup(fault_msg, title="External Control Safety Fault", error=True, blocking=False)
        halt()

def runServoIteration():
    with SERVOJ_DATA_MUTEX:
        joints = cmd_servo_joints
    servoj(joints, {{SERVO_J_REPLACE}})

def servoThread():
    textmsg("ExternalControl: Starting servo thread")
    while control_mode == MODE_SERVOJ:
        runServoIteration()
    textmsg("ExternalControl: servo thread ended")
    stopj(STOPJ_ACCELERATION)


# Drains the points of an abandoned trajectory. A timed-out read means nothing
# more is buffered, so the drain stops there instead of blocking the caller.
def trajectoryClearPoints():
    global trajectory_point_num
    while trajectory_point_num > 0:
        raw_point = socket_read_binary_integer(TRAJECTORY_DATA_SIZE, "trajectory_socket", get_steptime())
        if raw_point[0] > 0:
            trajectory_point_num = trajectory_point_num - 1
        else:
            trajectory_point_num = 0

def setSpeedl(tool_vel):
    global cmd_speedl_tool_speed
    global control_mode
    control_mode = MODE_SPEEDL
    with SPEED_DATA_MUTEX:
        cmd_speedl_tool_speed = tool_vel

def setSpeedj(joint_vel):
    global cmd_speed_joint
    global control_mode
    control_mode = MODE_SPEEDJ
    with SPEED_DATA_MUTEX:
        cmd_speed_joint = joint_vel

def runSpeedlIteration():
    with SPEED_DATA_MUTEX:
        speedl_tool_speed = cmd_speedl_tool_speed
    speedl(speedl_tool_speed, 40.0, steptime)

def speedlThread():
    textmsg("Starting speedl thread")
    while control_mode == MODE_SPEEDL:
        runSpeedlIteration()
    textmsg("speedl thread ended")
    stopj(STOPJ_ACCELERATION)

def runSpeedjIteration():
    with SPEED_DATA_MUTEX:
        speedj_vel = cmd_speed_joint
    speedj(speedj_vel, 40.0, steptime)

def speedjThread():
    textmsg("Starting speedj thread")
    while control_mode == MODE_SPEEDJ:
        runSpeedjIteration()
    textmsg("speedj thread ended")
    stopj(STOPJ_ACCELERATION)

# One iteration of the one-shot script command loop, the commands shouldn't be blocking
def runScriptCommandIteration():
    raw_command = socket_read_binary_integer(SCRIPT_COMMAND_DATA_SIZE, "script_command_socket", 0)
    if raw_command[0] > 0:
        command = raw_command[1]
        if command == SCRIPT_CMD_ZERO_FTSENSOR:
            zero_ftsensor()
        elif command == SCRIPT_CMD_SET_PAYLOAD:
            mass = raw_command[2] / COMMON_ZOOM_RATIO
            cog = [raw_command[3] / COMMON_ZOOM_RATIO, raw_command[4] / COMMON_ZOOM_RATIO, raw_command[5] / COMMON_ZOOM_RATIO]
            # Ensure message bytes evaluate to valid payload
            mass_str = 'mass: ' + str(mass)
            cog_str = 'CoG: ' + str(cog)
            payload_str = mass_str + ' | ' + cog_str
            # Successive textmsg() calls can drop messages, so each log is a single string
            if mass >= 0.0 and mass <= PAYLOAD_MASS_MAX:
                textmsg("Set payload: " + payload_str)
                set_payload(mass, cog)
            else:
                textmsg("ExternalControl: payload refused | " + payload_str + " | limit=" + str(PAYLOAD_MASS_MAX))
        elif command == SCRIPT_CMD_SET_TOOL_VOLTAGE:
            tool_voltage = raw_command[2] / COMMON_ZOOM_RATIO
            tool_voltage = int(tool_voltage)
            # Ensure message bytes evaluate to a supported voltage, including off
            if tool_voltage == TOOL_VOLTAGE_OFF or tool_voltage == TOOL_VOLTAGE_12V or tool_voltage == TOOL_VOLTAGE_24V:
                textmsg("Set tool voltage: " + str(tool_voltage))
                set_tool_voltage(tool_voltage)
            else:
                textmsg("ExternalControl: tool voltage refused | " + str(tool_voltage) + " is not 0, 12, or 24")
        elif command == SCRIPT_CMD_START_FORCE_MODE:
            task_frame = [raw_command[2] / COMMON_ZOOM_RATIO, raw_command[3] / COMMON_ZOOM_RATIO, raw_command[4] / COMMON_ZOOM_RATIO, raw_command[5] / COMMON_ZOOM_RATIO, raw_command[6] / COMMON_ZOOM_RATIO, raw_command[7] / COMMON_ZOOM_RATIO]
            # The host sends the selection vector unscaled
            selection_vector = [raw_command[8], raw_command[9], raw_command[10], raw_command[11], raw_command[12], raw_command[13]]
            wrench = [raw_command[14] / COMMON_ZOOM_RATIO, raw_command[15] / COMMON_ZOOM_RATIO, raw_command[16] / COMMON_ZOOM_RATIO, raw_command[17] / COMMON_ZOOM_RATIO, raw_command[18] / COMMON_ZOOM_RATIO, raw_command[19] / COMMON_ZOOM_RATIO]
            force_type = raw_command[20]
            force_limits = [raw_command[21] / COMMON_ZOOM_RATIO, raw_command[22] / COMMON_ZOOM_RATIO, raw_command[23] / COMMON_ZOOM_RATIO, raw_command[24] / COMMON_ZOOM_RATIO, raw_command[25] / COMMON_ZOOM_RATIO, raw_command[26] / COMMON_ZOOM_RATIO]
            force_mode(task_frame, selection_vector, wrench, force_type, force_limits)
        elif command == SCRIPT_CMD_END_FORCE_MODE:
            end_force_mode()

def scriptCommands():
    while control_mode > MODE_STOPPED:
        runScriptCommandIteration()

def openControlSockets():
    textmsg("Reverse connection {{SERVER_IP_REPLACE}}:{{REVERSE_PORT_REPLACE}}...")
    textmsg("Trajectory connection {{SERVER_IP_REPLACE}}:{{TRAJECTORY_SERVER_PORT_REPLACE}}...")
    textmsg("Script command connection {{SERVER_IP_REPLACE}}:{{SCRIPT_COMMAND_PORT_REPLACE}}...")

    socket_open("{{SERVER_IP_REPLACE}}", {{REVERSE_PORT_REPLACE}}, "reverse_socket")
    socket_open("{{SERVER_IP_REPLACE}}", {{TRAJECTORY_SERVER_PORT_REPLACE}}, "trajectory_socket")
    socket_open("{{SERVER_IP_REPLACE}}", {{SCRIPT_COMMAND_PORT_REPLACE}}, "script_command_socket")

def initializeControlState():
    global cmd_speedl_tool_speed
    global cmd_speed_joint
    global control_mode
    global steptime
    global trajectory_point_num
    global cmd_servo_joints
    global servo_start_check_pending
    global trajectory_result
    global trajectory_point_wait
    global freedrive_active
    global script_command_thread_handle
    global move_thread_handle
    global trajectory_thread_handle
    global read_timeout
    cmd_speedl_tool_speed = [0, 0, 0, 0, 0, 0]
    cmd_speed_joint = [0, 0, 0, 0, 0, 0]
    control_mode = MODE_UNINITIALIZED
    steptime = get_steptime()
    trajectory_point_num = 0
    cmd_servo_joints = get_actual_joint_positions()
    servo_start_check_pending = False
    trajectory_result = TRAJECTORY_RESULT_SUCCESS
    trajectory_point_wait = 0.0
    freedrive_active = False
    script_command_thread_handle = start_thread(scriptCommands, ())
    move_thread_handle = 0
    trajectory_thread_handle = 0
    read_timeout = 0.0 # First read is blocking

def readReverseCommand():
    global read_timeout
    # First byte of response is return value of the read itself.
    # This offsets the byte indexing by 1 from what the driver sends.
    params_mult = socket_read_binary_integer(REVERSE_DATA_SIZE, "reverse_socket", read_timeout)
    if params_mult[0] > 0:
        # Convert to read timeout from milliseconds to seconds
        read_timeout = params_mult[1] / 1000.0
    return params_mult

def handleControlModeSwitch(new_mode):
    global control_mode
    global move_thread_handle
    global trajectory_thread_handle
    global cmd_servo_joints
    global servo_start_check_pending
    global cmd_speedl_tool_speed
    global cmd_speed_joint
    global freedrive_active
    # Clear remaining trajectory points
    if control_mode == MODE_TRAJECTORY:
        stop_thread(trajectory_thread_handle)
        trajectory_thread_handle = 0
        stopj(STOPJ_ACCELERATION)
        trajectoryClearPoints()
        socket_send_int(TRAJECTORY_RESULT_CANCELED, "trajectory_socket")
    elif control_mode == MODE_FREEDRIVE:
        # FREEDRIVE_END may have ended freedrive already
        if freedrive_active:
            textmsg("End freedrive mode")
            end_freedrive_mode()
            freedrive_active = False
    else:
        stop_thread(move_thread_handle)
        move_thread_handle = 0
        stopj(STOPJ_ACCELERATION)

    control_mode = new_mode

    # Start new motion mode
    # Each velocity session starts at rest rather than at the last session's command
    if control_mode == MODE_SPEEDL:
        cmd_speedl_tool_speed = [0, 0, 0, 0, 0, 0]
        move_thread_handle = start_thread(speedlThread, ())
    elif control_mode == MODE_TRAJECTORY:
        stop_thread(move_thread_handle)
        move_thread_handle = 0
        stopj(STOPJ_ACCELERATION)
    elif control_mode == MODE_SPEEDJ:
        cmd_speed_joint = [0, 0, 0, 0, 0, 0]
        move_thread_handle = start_thread(speedjThread, ())
    elif control_mode == MODE_SERVOJ:
        cmd_servo_joints = get_actual_joint_positions()
        servo_start_check_pending = True
        move_thread_handle = start_thread(servoThread, ())

    # Log when a script stop is commanded externally
    elif control_mode == MODE_STOPPED:
        textmsg("ExternalControl: Script stopped")

def applyModeCommand(params_mult):
    global trajectory_thread_handle
    global trajectory_point_num
    global freedrive_active
    # Update the motion commands with new parameters
    if control_mode == MODE_SERVOJ:
        joints = [params_mult[2]/ POS_ZOOM_RATIO, params_mult[3]/ POS_ZOOM_RATIO, params_mult[4]/ POS_ZOOM_RATIO, params_mult[5]/ POS_ZOOM_RATIO, params_mult[6]/ POS_ZOOM_RATIO, params_mult[7]/ POS_ZOOM_RATIO]
        # A refused start target never reaches cmd_servo_joints, so the arm keeps holding
        if servo_start_check_pending:
            verifyServoStartSetpoint(joints)
        if servo_start_check_pending == False:
            setServoSetpoint(joints)
    elif control_mode == MODE_SPEEDL:
        setSpeedl([params_mult[2] / POS_ZOOM_RATIO, params_mult[3] / POS_ZOOM_RATIO, params_mult[4] / POS_ZOOM_RATIO, params_mult[5] / POS_ZOOM_RATIO, params_mult[6] / POS_ZOOM_RATIO, params_mult[7] / POS_ZOOM_RATIO])
    elif control_mode == MODE_SPEEDJ:
        setSpeedj([params_mult[2] / POS_ZOOM_RATIO, params_mult[3] / POS_ZOOM_RATIO, params_mult[4] / POS_ZOOM_RATIO, params_mult[5] / POS_ZOOM_RATIO, params_mult[6] / POS_ZOOM_RATIO, params_mult[7] / POS_ZOOM_RATIO])
    elif control_mode == MODE_TRAJECTORY:
        if params_mult[2] == TRAJECTORY_ACTION_START:
            stop_thread(trajectory_thread_handle)
            trajectory_thread_handle = 0
            trajectoryClearPoints()
            trajectory_point_num = params_mult[3]
            trajectory_thread_handle = start_thread(trajectoryThread, ())
        elif params_mult[2] == TRAJECTORY_ACTION_CANCEL:
            textmsg("Trajectory cancel received")
            stop_thread(trajectory_thread_handle)
            trajectory_thread_handle = 0
            trajectoryClearPoints()
            stopj(STOPJ_ACCELERATION)
            socket_send_int(TRAJECTORY_RESULT_CANCELED, "trajectory_socket")
    elif control_mode == MODE_FREEDRIVE:
        if params_mult[2] == FREEDRIVE_START:
            textmsg("Start freedrive mode")
            freedrive_mode()
            freedrive_active = True
        elif params_mult[2] == FREEDRIVE_END:
            textmsg("End freedrive mode")
            end_freedrive_mode()
            freedrive_active = False

def runControlLoopIteration():
    global control_mode
    params_mult = readReverseCommand()
    if params_mult[0] > 0:
        # Update new motion mode
        if control_mode != params_mult[REVERSE_DATA_SIZE]:
            handleControlModeSwitch(params_mult[REVERSE_DATA_SIZE])
        applyModeCommand(params_mult)
    else:
        textmsg("Socket timed out waiting for command on reverse_socket. The script will exit now.")
        control_mode = MODE_STOPPED

def shutdownControlThreads(script_command_thread_handle, move_thread_handle, trajectory_thread_handle):
    stop_thread(script_command_thread_handle)
    join_thread(script_command_thread_handle)
    stop_thread(move_thread_handle)
    join_thread(move_thread_handle)
    stop_thread(trajectory_thread_handle)
    join_thread(trajectory_thread_handle)
    stopj(STOPJ_ACCELERATION)
    textmsg("ExternalControl: All threads ended")
    socket_close("reverse_socket")
    socket_close("trajectory_socket")
    socket_close("script_command_socket")

# HEADER_END


# NODE_CONTROL_LOOP_BEGINS
openControlSockets()
initializeControlState()

while control_mode > MODE_STOPPED:
    runControlLoopIteration()

shutdownControlThreads(script_command_thread_handle, move_thread_handle, trajectory_thread_handle)

# NODE_CONTROL_LOOP_ENDS
